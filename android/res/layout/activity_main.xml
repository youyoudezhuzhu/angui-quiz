<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="安规搜题"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="通知栏里直接搜题 · 119 道安规 / 变电检修题"
            android:textColor="@color/text_soft"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="5dp"
            android:padding="18dp"
            android:textColor="@color/text_soft"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_enable"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/primary"
            android:text="开启 / 刷新通知栏搜题"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#E2E8F0"
            android:text="关闭通知栏搜题"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#E2E8F0"
            android:text="系统通知设置"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="6dp"
            android:padding="18dp"
            android:text="在通知栏里搜题（无需打开 App）\n\n① 下拉通知栏，找到「安规搜题」通知\n② 点通知上的「搜索」，输入题干关键词后发送\n③ 答案和选项直接显示在通知里\n④ 点「下一条」翻看其他匹配题；点「关闭」移除通知栏\n⑤ 点「关闭」可移除通知栏搜题\n\n关键词示例：安全带、接地线、工作票、十不干、高处作业、绝缘手套"
            android:textColor="@color/text_soft"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="题库与网页版同源 · 全部本地搜索，不联网"
            android:textColor="@color/text_mute"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
